# Пример конфигурации панели. Скопируйте в .env и заполните значения.

# Ключ шифрования секретов (AES-256-GCM), base64 от 32 случайных байт.
# Сгенерировать: ./scripts/gen_key.sh   или   openssl rand -base64 32
# Если не задан — панель сгенерирует ключ и сохранит в ./data/master.key (только для dev!).
SECRETS_ENCRYPTION_KEY=

# Каталог данных (БД SQLite + master.key в dev-режиме)
SPANEL_DATA_DIR=./data

# Путь к базе данных
# SPANEL_DB=./data/spanel.db

# Адрес и порт панели
PANEL_HOST=0.0.0.0
PANEL_PORT=8080

# Базовый домен для публичных поддоменов сервисов (https://<slug>.<domain>)
BASE_DOMAIN=tunnel.local
