[Unit]
Description=spanel — панель проксирования веб-интерфейсов через SSH
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# измените на путь установки, например /opt/spanel
WorkingDirectory=/opt/spanel
EnvironmentFile=-/opt/spanel/.env
ExecStart=/opt/spanel/.venv/bin/python -m uvicorn app.main:app --host 0.0.0.0 --port 8080
Restart=on-failure
RestartSec=3

# базовое усиление безопасности
NoNewPrivileges=true
ProtectSystem=full
ReadWritePaths=/opt/spanel/data
PrivateTmp=true

[Install]
WantedBy=multi-user.target
